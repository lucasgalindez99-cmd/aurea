{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/.git/**",
      ".firebase/**",
      ".vscode/**",
      ".git/**",
      "**/node_modules/**",
      "Cod*/**",
      "_respaldo*/**",
      "*.docx",
      "*.md",
      "*.rules",
      "assets/*.orig.*"
    ],
    "cleanUrls": true,
    "headers": [
      {
        "source": "assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  }
}